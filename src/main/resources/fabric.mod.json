{
	"schemaVersion": 1,
	"id": "barless",
	"version": "${version}",
	"name": "Barless",
	"description": "A mod that removes the ugly top bar from your minecraft window",
	"authors": [
		"BouncingElf10"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/barless",
		"sources": "https://github.com/BouncingElf10/Barless"
	},
	"license": "GPL-3.0",
	"icon": "assets/barless/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
          "com.bouncingelf10.barless.BarlessClient"
		]
	},
	"mixins": [
		"barless.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=1.21.6 <=1.21.8",
		"java": ">=21",
		"fabric-api": "*",
		"timelesslib": ">=1.0.21-fabric-1.20.5-1.21.11"
	}
}